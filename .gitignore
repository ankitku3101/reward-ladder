# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# NOTE: /public/r/ is deliberately NOT ignored. It's generated by
# `npm run registry:build`, but it's committed so the registry is served
# even if the build step misbehaves on the host. Re-run that script and
# commit the result whenever anything in components/reward-ladder/ changes.

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.playwright-mcp/
.hallmark/